# 1. 전 세계 어디서나 똑같은 환경을 보장하기 위해 표준 가벼운 Node.js 버전을 가져옵니다
FROM node:20-alpine

# 2. 가상 컴퓨터 안에서 프로그램이 실행될 중심 폴더 방을 만듭니다
WORKDIR /usr/src/app

# 3. 설치 가이드 문서(이름표)들을 먼저 가상 컴퓨터 안으로 복사합니다
COPY package*.json ./

# 4. 프로덕션(실제 서비스) 구동에 필요한 핵심 도구들만 깔끔하게 설치합니다
RUN npm install --only=production

# 5. 우리가 한 땀 한 땀 작성한 모든 소스 코드 파일들을 통째로 복사해 넣습니다
COPY . .

# 6. 외부 인터넷 세상과 소통할 웹 서버 포트 3000번을 열어줍니다 (5주차 원칙)
EXPOSE 3000

# 7. 이 도커 상자가 실행되는 순간, 우리 서버를 켜는 명령어(node app.js)를 실행합니다 (14주차)
CMD ["node", "app.js"]