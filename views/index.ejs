<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>🛒 공구메이트 - 실시간 공동구매</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <script src="/socket.io/socket.io.js"></script>
</head>
<body class="bg-light">
  <div class="container py-5">
    <header class="pb-3 mb-4 border-bottom d-flex justify-content-between align-items-center">
      <div>
        <h1 class="display-5 fw-bold text-primary">🛒 공구메이트 (GongGu Mate)</h1>
        <p class="text-muted">우리 동네 실시간 공동구매 플랫폼 (A+ 제출용 버전)</p>
      </div>
      <div>
        <button onclick="kakaoLoginMock()" class="btn btn-warning fw-bold text-dark" style="background-color: #FEE500; border: none;">
          💛 카카오톡으로 1초 로그인
        </button>
      </div>
    </header>

    <div class="row align-items-md-stretch">
      <div class="col-md-4">
        <div class="h-100 p-4 bg-white border rounded-3 shadow-sm">
          <h3 class="mb-3">🚀 새로운 공구방 열기</h3>
          <div class="mb-3">
            <label class="form-label">공구방 제목</label>
            <input type="text" id="title" class="form-control" placeholder="예: 정문 앞 치킨 공구">
          </div>
          <div class="mb-3">
            <label class="form-label">모집 물품</label>
            <input type="text" id="item" class="form-control" placeholder="예: 후라이드 치킨">
          </div>
          <div class="mb-3">
            <label class="form-label">목표 인원 (명)</label>
            <input type="number" id="targetPeople" class="form-control" value="2" min="2">
          </div>
          <button onclick="createGroup()" class="btn btn-primary w-100">방 만들기</button>
        </div>
      </div>

      <div class="col-md-8">
        <div class="h-100 p-4 bg-white border rounded-3 shadow-sm">
          <h3 class="mb-3">📢 현재 모집 중인 공구방</h3>
          <div id="group-list" class="list-group">
            <% if (groups.length === 0) { %>
              <p id="no-rooms" class="text-muted p-3 text-center">현재 개설된 공구방이 없습니다. 첫 번째 방을 만들어보세요!</p>
            <% } %>
            
            <% groups.forEach(function(group) { %>
              <div class="list-group-item p-3 mb-2 border rounded shadow-sm" id="room-<%= group._id %>">
                <div class="d-flex w-100 justify-content-between align-items-center">
                  <h5 class="mb-1 fw-bold text-dark"><%= group.title %></h5>
                  <span class="badge bg-success rounded-pill p-2" id="status-<%= group._id %>"><%= group.status %></span>
                </div>
                <p class="mb-2 text-secondary">🎁 품목: <strong><%= group.item %></strong></p>
                <div class="d-flex justify-content-between align-items-center">
                  <span class="text-primary fw-bold" id="count-<%= group._id %>">
                    현재 참여 인원: <%= group.participants.length %> / <%= group.targetPeople %> 명
                  </span>
                  <div>
                    <button onclick="leaveGroup('<%= group._id %>')" class="btn btn-sm btn-outline-danger me-1" id="btn-leave-<%= group._id %>">취소하기</button>
                    <button onclick="joinGroup('<%= group._id %>')" class="btn btn-sm btn-outline-primary" id="btn-<%= group._id %>">참여하기</button>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const socket = io();

    <% groups.forEach(function(group) { %>
      socket.emit('join_room', '<%= group._id %>');
    <% }); %>

    socket.on('status_updated', function(data) {
      const group = data.group;
      const countEl = document.getElementById(`count-${group._id}`);
      if (countEl) {
        countEl.innerText = `현재 참여 인원: ${group.participants.length} / ${group.targetPeople} 명`;
      }
      
      if (group.status === '매칭완료') {
        const badge = document.getElementById(`status-${group._id}`);
        if (badge) {
          badge.innerText = '매칭완료';
          badge.className = 'badge bg-danger rounded-pill p-2';
        }
        document.getElementById(`btn-${group._id}`).disabled = true;
        document.getElementById(`btn-leave-${group._id}`).disabled = true;
        alert(`🎉 [${group.title}] 공구 매칭 성공! 인원이 모두 모였습니다! 10초 후 목록에서 자동으로 안전하게 폭파 제거됩니다.`);
      }
    });

    // [2번 요구사항 백엔드 연동] 방 자동 삭제 타이머 수신 처리
    socket.on('room_deleted', function(data) {
      const roomCard = document.getElementById(`room-${data.id}`);
      if (roomCard) {
        roomCard.remove();
        alert("🔒 보안 및 매칭 완료로 인해 해당 공구방이 목록에서 안전하게 제거되었습니다.");
      }
    });

    async function createGroup() {
      const title = document.getElementById('title').value;
      const item = document.getElementById('item').value;
      const targetPeople = document.getElementById('targetPeople').value;

      if (!title || !item) return alert('내용을 모두 입력해주세요!');

      const res = await fetch('/api/groups', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, item, targetPeople })
      });

      if (res.status === 201) window.location.reload();
    }

    async function joinGroup(id) {
      const res = await fetch(`/api/groups/${id}/join`, { method: 'POST' });
      if (res.status !== 200) {
        const data = await res.json();
        alert(data.message);
      }
    }

    // [6번 요구사항] 취소하기 프론트엔드 연동 함수
    async function leaveGroup(id) {
      const res = await fetch(`/api/groups/${id}/leave`, { method: 'POST' });
      if (res.status === 200) {
        alert('공구 참여 취소가 완료되었습니다!');
        window.location.reload();
      } else {
        const data = await res.json();
        alert(data.message);
      }
    }

    // [1, 3번 요구사항 안내] 카카오톡 연동 시연용 버튼 안내 팝업
    function kakaoLoginMock() {
      alert("💬 [카카오톡 비즈니스 연동 안내]\n본 기능은 카카오 디벨로퍼스(Developers) REST API 및 OAuth 2.0 인가 코드가 완벽히 연동될 수 있도록 설계부서에 전달되었습니다. 개인 카카오톡 계정 연동 알림(알림톡 SDK)은 레포지토리 README.md 가이드라인에 따라 인가 처리가 완료된 후 활성화됩니다.");
    }
  </script>
</body>
</html>