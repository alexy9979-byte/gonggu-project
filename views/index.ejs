<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>🛒 실시간 우리 대학교 공구메이트</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background-color: #f8f9fa; font-family: 'Pretendard', sans-serif; }
    .card { border-radius: 12px; border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
    .kakao-btn {
      background-color: #FEE500; color: #191919; border: none; padding: 14px;
      font-size: 16px; font-weight: bold; border-radius: 8px; width: 100%;
      display: flex; align-items: center; justify-content: center; gap: 10px;
      transition: all 0.2s;
    }
    .kakao-btn:hover { background-color: #FADA0A; opacity: 0.9; }
    .badge-recruiting { background-color: #0d6efd; }
    .badge-matched { background-color: #198754; }
    .dist-badge-date { background-color: #198754; color: white; }
    .dist-badge-loc { background-color: #212529; color: white; }
  </style>
</head>
<body>

  <div class="container py-5">
    <!-- 🎓 상단 타이틀 -->
    <div class="text-center mb-5">
      <h1 class="display-5 fw-bold text-primary">🛒 공구메이트</h1>
      <p class="text-muted">우리 대학교 학생들과 함께하는 실시간 공동구매 플랫폼</p>
    </div>

    <!-- 1. 통합 인증 섹션 (자체 회원가입/로그인 + 카카오) -->
    <div id="auth-section" class="card p-4 mx-auto mb-5" style="max-width: 450px;">
      <!-- 상단 탭 스위치 -->
      <div class="d-flex justify-content-center gap-3 mb-4">
        <button id="tab-login-btn" class="btn btn-primary btn-sm px-4" onclick="switchAuthTab('login')">로그인</button>
        <button id="tab-reg-btn" class="btn btn-outline-secondary btn-sm px-4" onclick="switchAuthTab('register')">회원가입</button>
      </div>

      <!-- [A] 로그인 폼 -->
      <div id="form-login-box">
        <h5 class="fw-bold mb-3">🎓 학번으로 로그인</h5>
        <div class="mb-3">
          <input type="text" id="login-student-id" class="form-control" placeholder="학번 입력 (예: 20261234)">
        </div>
        <div class="mb-3">
          <input type="password" id="login-pwd" class="form-control" placeholder="비밀번호">
        </div>
        <button onclick="handleLocalLogin()" class="btn btn-dark w-100 fw-bold mb-3 py-2">로그인</button>
        
        <div class="text-center text-muted small mb-3">또는 간편 연동</div>
        <button onclick="handleKakaoLogin()" class="kakao-btn">
          <span>💬</span> 카카오 계정 로그인
        </button>
      </div>

      <!-- [B] 회원가입 폼 -->
      <div id="form-register-box" style="display: none;">
        <h5 class="fw-bold mb-3 text-success">📝 학생 회원가입</h5>
        <div class="mb-3">
          <label class="form-label small fw-bold">학번</label>
          <input type="text" id="reg-student-id" class="form-control" placeholder="학번 8자리 입력">
        </div>
        <div class="mb-3">
          <label class="form-label small fw-bold">이름 (본명)</label>
          <input type="text" id="reg-name" class="form-control" placeholder="홍길동">
        </div>
        <div class="mb-3">
          <label class="form-label small fw-bold">비밀번호 설정</label>
          <input type="password" id="reg-pwd" class="form-control" placeholder="비밀번호 입력">
        </div>
        <button onclick="handleLocalRegister()" class="btn btn-success w-100 fw-bold py-2">가입 완료하기</button>
      </div>
    </div>

    <!-- 2. 메인 대시보드 섹션 -->
    <div id="main-dashboard" style="display: none;">
      <div class="alert alert-light card p-3 d-flex flex-row justify-content-between align-items-center mb-4">
        <div>
          🎉 안녕하세요, <span class="fw-bold text-success" id="user-display-name">유저명</span>님! 
          <span class="badge bg-info text-white ms-2" id="noti-status">🔔 실시간 알림 대기중</span>
        </div>
        <button onclick="handleLogout()" class="btn btn-outline-danger btn-sm">로그아웃</button>
      </div>

      <div class="row">
        <!-- 왼쪽: 공구방 개설 폼 -->
        <div class="col-md-4 mb-4">
          <div class="card p-4 h-100">
            <h4 class="fw-bold text-dark mb-4">📦 새로운 공구 열기</h4>
            <div class="mb-3">
              <label class="form-label small fw-bold">공구방 제목</label>
              <input type="text" id="group-title" class="form-control" placeholder="예: 경영학원론 제3판 같이 사요">
            </div>
            <div class="mb-3">
              <label class="form-label small fw-bold">구매 물품명 (전공책 등)</label>
              <input type="text" id="group-item" class="form-control" placeholder="예: 무역출판사 경영학원론 교재">
            </div>
            <div class="mb-3">
              <label class="form-label small fw-bold">목표 인원 설정 (명)</label>
              <input type="number" id="group-target" class="form-control" value="2" min="2">
            </div>
            <div class="mb-3">
              <label class="form-label small fw-bold">모집 마감일 선택 (캘린더)</label>
              <input type="date" id="group-deadline-date" class="form-control">
            </div>
            
            <!-- 📅 배포 날짜 달력 -->
            <div class="mb-3">
              <label class="form-label small fw-bold text-success">📅 배포(수령) 희망 날짜</label>
              <input type="date" id="group-dist-date" class="form-control">
            </div>

            <!-- 🏫 성공회대 전용 배포 장소 -->
            <div class="mb-4">
              <label class="form-label small fw-bold text-success">📍 배포(수령) 장소 선택</label>
              <select id="group-dist-location" class="form-select">
                <option value="승연관">승연관 (일반 강의실/한국어학당)</option>
                <option value="일만관">일만관 (대학본부/중심 건물)</option>
                <option value="월당관">월당관 (계단식/다목적 강의실)</option>
                <option value="이천환 기념관">이천환 기념관 (정보과학관/실습실)</option>
                <option value="새천년관">새천년관 (학식/매점/카페테리아)</option>
                <option value="미가엘관">미가엘관 (강의실 및 기숙사 복합동)</option>
                <option value="나눔관">나눔관 (우편소/문구점/복사실)</option>
                <option value="성미가엘성당 및 피츠버그홀">성미가엘성당 및 피츠버그홀 (채플/강연)</option>
                <option value="중앙도서관">중앙도서관 (열람실/역사자료관)</option>
                <option value="행복기숙사 (더·숲)">행복기숙사 더·숲 (대학 기숙사)</option>
                <option value="구두인관">구두인관 (신학원/사회진출지원센터)</option>
              </select>
            </div>

            <button onclick="createGroup()" class="btn btn-primary w-100 fw-bold py-2">🚀 공동구매 방 개설</button>
          </div>
        </div>

        <!-- 오른쪽: 실시간 캠퍼스 공구 목록 리스트 -->
        <div class="col-md-8 mb-4">
          <div class="card p-4 h-100">
            <h4 class="fw-bold text-dark mb-4">⚡ 캠퍼스 실시간 공구 목록</h4>
            <div id="group-list" class="row row-cols-1 g-3">
              
              <% if (groups && groups.length > 0) { %>
                <% groups.forEach(function(group) { %>
                  <div class="col" id="card-<%= group._id %>">
                    <div class="card p-3 border-start border-4 <%= group.status === '모집중' ? 'border-primary' : 'border-success' %>">
                      <div class="d-flex justify-content-between align-items-start">
                        <div>
                          <span class="badge <%= group.status === '모집중' ? 'badge-recruiting' : 'badge-matched' %> mb-2" id="status-badge-<%= group._id %>">
                            <%= group.status %>
                          </span>
                          <h5 class="fw-bold mb-1"><%= group.title %></h5>
                          <p class="text-muted small mb-2">📦 물품: <%= group.item %></p>
                          
                          <!-- 배포 날짜 및 건물 뱃지 -->
                          <div class="mb-2">
                            <span class="badge dist-badge-date">📅 배포일: <%= group.distDate %></span>
                            <span class="badge dist-badge-loc">📍 장소: <%= group.distLocation %></span>
                          </div>

                          <div class="small text-muted">
                            👥 참여 명단 (<span id="count-<%= group._id %>"><%= group.participants.length %></span>/<%= group.targetPeople %>명): 
                            <span class="text-dark fw-bold" id="people-<%= group._id %>"><%= group.participants.join(', ') %></span>
                          </div>
                        </div>
                        <div class="d-flex flex-column gap-2 text-end" id="btn-area-<%= group._id %>">
                          <div class="small text-danger fw-bold mb-1">
                            ⏳ 모집마감: <span id="time-display-<%= group._id %>"><%= new Date(group.deadline).toLocaleDateString() %></span> 까지
                          </div>
                          <% if (group.status === '모집중') { %>
                            <button onclick="joinGroup('<%= group._id %>')" class="btn btn-sm btn-outline-primary px-3">참여하기</button>
                            <button onclick="extendGroup('<%= group._id %>')" class="btn btn-sm btn-outline-warning px-3">📅 기한 연장 (+1일)</button>
                            <button onclick="leaveGroup('<%= group._id %>')" class="btn btn-sm btn-outline-danger px-3">취소</button>
                          <% } else { %>
                            <button class="btn btn-sm btn-secondary" disabled>매칭완료</button>
                          <% } %>
                        </div>
                      </div>
                    </div>
                  </div>
                <% }); %>
              <% } else { %>
                <div class="text-center py-5 text-muted" id="empty-message">
                  현재 개설된 공구방이 없습니다. 가입 후 첫 방을 빌드해 보세요!
                </div>
              <% } %>

            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
    let currentUser = localStorage.getItem('공구메이트_유저') || null;

    window.onload = function() {
      if (currentUser) {
        document.getElementById('auth-section').style.display = 'none';
        document.getElementById('main-dashboard').style.display = 'block';
        document.getElementById('user-display-name').innerText = currentUser;
        
        requestNotificationPermission();
        initDefaultDates();
      } else {
        document.getElementById('auth-section').style.display = 'block';
        document.getElementById('main-dashboard').style.display = 'none';
      }
    };

    function initDefaultDates() {
      const todayStr = new Date().toISOString().substring(0, 10);
      
      const deadlineInput = document.getElementById('group-deadline-date');
      if (deadlineInput) {
        deadlineInput.value = todayStr;
        deadlineInput.min = todayStr;
      }

      const distInput = document.getElementById('group-dist-date');
      if (distInput) {
        distInput.value = todayStr;
        distInput.min = todayStr;
      }
    }

    function requestNotificationPermission() {
      if (!("Notification" in window)) return;
      if (Notification.permission !== "granted" && Notification.permission !== "denied") {
        Notification.requestPermission().then(permission => {
          if (permission === "granted") setNotiBadgeActive();
        });
      } else if (Notification.permission === "granted") {
        setNotiBadgeActive();
      }
    }

    function setNotiBadgeActive() {
      const badge = document.getElementById('noti-status');
      if (badge) {
        badge.innerText = "🔔 실시간 푸시 알림 ON";
        badge.className = "badge bg-success text-white ms-1";
      }
    }

    function spawnNotification(title, body) {
      if (Notification.permission === "granted") {
        new Notification(title, {
          body: body,
          icon: 'https://cdn-icons-png.flaticon.com/512/3081/3081986.png'
        });
      }
    }

    async function handleKakaoLogin() {
      try {
        const res = await fetch('/api/auth/kakao/url');
        const data = await res.json();
        if (data.url) window.location.href = data.url;
      } catch (e) {
        alert("네트워크 오류가 발생했습니다.");
      }
    }

    function handleLogout() {
      localStorage.removeItem('공구메이트_유저');
      location.reload();
    }

    async function createGroup() {
      const title = document.getElementById('group-title').value;
      const item = document.getElementById('group-item').value;
      const targetPeople = document.getElementById('group-target').value;
      const deadlineDateStr = document.getElementById('group-deadline-date').value;
      const distDate = document.getElementById('group-dist-date').value;
      const distLocation = document.getElementById('group-dist-location').value;

      if (!title || !item || !deadlineDateStr || !distDate) {
        return alert("공구방 개설 정보를 빠짐없이 모두 입력해주세요!");
      }

      const res = await fetch('/api/groups', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ 
          title, item, targetPeople, deadlineDateStr, distDate, distLocation, writer: currentUser 
        })
      });

      if (res.status === 201) {
        alert("🚀 성공적으로 배포 정보가 포함된 공구방이 개설되었습니다!");
        location.reload();
      }
    }

    async function extendGroup(id) {
      const res = await fetch(`/api/groups/${id}/extend`, { 
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userName: currentUser })
      });
      const data = await res.json();
      alert(data.message);
    }

    async function joinGroup(id) {
      const res = await fetch(`/api/groups/${id}/join`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userName: currentUser })
      });
      const data = await res.json();
      alert(data.message);
    }

    async function leaveGroup(id) {
      const res = await fetch(`/api/groups/${id}/leave`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userName: currentUser })
      });
      const data = await res.json();
      alert(data.message);
      if (res.status === 200 && data.action === 'delete') {
        location.reload();
      }
    }

    // 🔄 로그인 / 회원가입 화면 탭 전환 함수
    function switchAuthTab(type) {
      const loginBox = document.getElementById('form-login-box');
      const regBox = document.getElementById('form-register-box');
      const loginBtn = document.getElementById('tab-login-btn');
      const regBtn = document.getElementById('tab-reg-btn');

      if (type === 'login') {
        loginBox.style.display = 'block';
        regBox.style.display = 'none';
        loginBtn.className = "btn btn-primary btn-sm px-4";
        regBtn.className = "btn btn-outline-secondary btn-sm px-4";
      } else {
        loginBox.style.display = 'none';
        regBox.style.display = 'block';
        loginBtn.className = "btn btn-outline-secondary btn-sm px-4";
        regBtn.className = "btn btn-success btn-sm px-4";
      }
    }

    // 📝 일반 회원가입 요청 함수
    async function handleLocalRegister() {
      const studentId = document.getElementById('reg-student-id').value;
      const name = document.getElementById('reg-name').value;
      const password = document.getElementById('reg-pwd').value;

      const res = await fetch('/api/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ studentId, name, password })
      });

      const data = await res.json();
      alert(data.message);
      if (res.status === 201) switchAuthTab('login');
    }

    // 🔑 일반 로그인 요청 함수
    async function handleLocalLogin() {
      const studentId = document.getElementById('login-student-id').value;
      const password = document.getElementById('login-pwd').value;

      const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ studentId, password })
      });

      const data = await res.json();
      if (res.status === 200) {
        localStorage.setItem('공구메이트_유저', data.userName);
        alert(`👋 안녕하세요, ${data.userName}님! 반갑습니다.`);
        location.reload();
      } else {
        alert(data.message);
      }
    }

    // ==========================================
    // 🛜 Socket.io 양방향 실시간 리스너 단락
    // ==========================================
    socket.on('status_updated', (data) => {
      const g = data.group;
      const countEl = document.getElementById(`count-${g._id}`);
      const peopleEl = document.getElementById(`people-${g._id}`);
      const timeDisplay = document.getElementById(`time-display-${g._id}`);
      
      if (countEl) countEl.innerText = g.participants.length;
      if (peopleEl) peopleEl.innerText = g.participants.join(', ');
      if (timeDisplay) timeDisplay.innerText = new Date(g.deadline).toLocaleDateString();

      if (g.participants.includes(currentUser) && g.status === '모집중') {
        const latestUser = g.participants[g.participants.length - 1];
        if (latestUser !== currentUser) {
          spawnNotification(`⚡ [공구메이트 참여 현황]`, `"${g.title}" 방에 ${latestUser}님이 탑승했습니다! (${g.participants.length}/${g.targetPeople}명)`);
        }
      }

      if (g.status === '매칭완료') {
        const badge = document.getElementById(`status-badge-${g._id}`);
        if (badge) {
          badge.className = "badge badge-matched mb-2";
          badge.innerText = "매칭완료";
        }
        const btnArea = document.getElementById(`btn-area-${g._id}`);
        if (btnArea) btnArea.innerHTML = `<button class="btn btn-sm btn-secondary" disabled>매칭완료</button>`;

        if (g.participants.includes(currentUser)) {
          spawnNotification(`🎉 [공구 매칭 성사!]`, `축하합니다! "${g.title}" 팀 매칭 완료.\n지정된 배포일(${g.distDate})에 [${g.distLocation}]에서 교재를 수령하세요!`);
        }
      }
    });

    socket.on('room_deleted', (data) => {
      const targetCard = document.getElementById(`card-${data.id}`);
      if (targetCard) {
        targetCard.remove();
        if (data.reason === 'timeout') {
          alert(`⏰ [기간 만료 통보]\n"${data.title}" 공구방의 모집 기한이 지나 자동 파기되었습니다.`);
          spawnNotification(`⏰ [기간 만료 취소]`, `"${data.title}" 방이 모집 기한 초과로 자동 취소되었습니다.`);
        }
      }
    });
  </script>
</body>
</html>