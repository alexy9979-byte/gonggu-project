<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>🛒 공구메이트 - 회원제 실시간 공동구매</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <script src="/socket.io/socket.io.js"></script>
</head>
<body class="bg-light">

  <div id="auth-section" class="container py-5 mt-5" style="max-width: 450px;">
    <div class="card p-4 shadow border-0 rounded-4">
      <h2 class="text-center fw-bold text-primary mb-4">🛒 공구메이트</h2>
      
      <div id="login-form">
        <h4 class="mb-3 fw-semibold">로그인</h4>
        <input type="email" id="login-email" class="form-control mb-2" placeholder="이메일 주소">
        <input type="password" id="login-password" class="form-control mb-3" placeholder="비밀번호">
        <button onclick="handleLogin()" class="btn btn-primary w-100 mb-3 fw-bold">로그인하기</button>
        <p class="text-center text-muted small">계정이 없으신가요? <a href="#" onclick="toggleAuth(true)">회원가입</a></p>
      </div>

      <div id="register-form" style="display: none;">
        <h4 class="mb-3 fw-semibold">회원가입</h4>
        <input type="text" id="reg-name" class="form-control mb-2" placeholder="이름 (닉네임)">
        <input type="email" id="reg-email" class="form-control mb-2" placeholder="사용할 이메일">
        <input type="password" id="reg-password" class="form-control mb-3" placeholder="비밀번호 설정">
        <button onclick="handleRegister()" class="btn btn-success w-100 mb-3 fw-bold">가입 완료하기</button>
        <p class="text-center text-muted small">이미 계정이 있으신가요? <a href="#" onclick="toggleAuth(false)">로그인</a></p>
      </div>
    </div>
  </div>

  <div id="main-section" class="container py-5" style="display: none;">
    <header class="pb-3 mb-4 border-bottom d-flex justify-content-between align-items-center">
      <div>
        <h1 class="display-5 fw-bold text-primary">🛒 공구메이트</h1>
        <p class="text-muted"><span id="user-welcome" class="fw-bold text-dark"></span>님 환영합니다! 우리 동네 실시간 공구 판</p>
      </div>
      <button onclick="handleLogout()" class="btn btn-sm btn-outline-secondary">로그아웃</button>
    </header>

    <div class="row align-items-md-stretch">
      <div class="col-md-4">
        <div class="h-100 p-4 bg-white border rounded-3 shadow-sm">
          <h3 class="mb-3">🚀 새로운 공구방 열기</h3>
          <div class="mb-3">
            <label class="form-label">공구방 제목</label>
            <input type="text" id="title" class="form-control" placeholder="예: 정문 앞 치킨 공구">
          </div>
          <div class="mb-3">
            <label class="form-label">모집 물품</label>
            <input type="text" id="item" class="form-control" placeholder="예: 후라이드 치킨">
          </div>
          <div class="mb-3">
            <label class="form-label">목표 인원 (명)</label>
            <input type="number" id="targetPeople" class="form-control" value="2" min="2">
          </div>
          <button onclick="createGroup()" class="btn btn-primary w-100">방 만들기</button>
        </div>
      </div>

      <div class="col-md-8">
        <div class="h-100 p-4 bg-white border rounded-3 shadow-sm">
          <h3 class="mb-3">📢 현재 모집 중인 공구방</h3>
          <div id="group-list" class="list-group">
            <% if (groups.length === 0) { %>
              <p id="no-rooms-msg" class="text-muted p-3 text-center">현재 개설된 공구방이 없습니다. 첫 번째 방을 만들어보세요!</p>
            <% } %>
            <% groups.forEach(function(group) { %>
              <div class="list-group-item p-3 mb-2 border rounded shadow-sm" id="room-<%= group._id %>">
                <div class="d-flex w-100 justify-content-between align-items-center">
                  <h5 class="mb-1 fw-bold text-dark"><%= group.title %></h5>
                  <span class="badge bg-success rounded-pill p-2" id="status-<%= group._id %>"><%= group.status %></span>
                </div>
                <p class="mb-2 text-secondary">🎁 품목: <strong><%= group.item %></strong></p>
                <div class="d-flex justify-content-between align-items-center">
                  <span class="text-primary fw-bold" id="count-<%= group._id %>">
                    참여자 목록: <span class="text-dark small" id="list-<%= group._id %>"><%= group.participants.join(', ') %></span> (<%= group.participants.length %> / <%= group.targetPeople %> 명)
                  </span>
                  <div>
                    <button onclick="leaveGroup('<%= group._id %>')" class="btn btn-sm btn-outline-danger me-1" id="btn-leave-<%= group._id %>">취소하기</button>
                    <button onclick="joinGroup('<%= group._id %>')" class="btn btn-sm btn-outline-primary" id="btn-<%= group._id %>">참여하기</button>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const socket = io();
    let currentUser = sessionStorage.getItem('userName'); // 세션에서 로그인 정보 획득

    // 페이지 로드 시 로그인 상태 체크
    if (currentUser) {
      showDashboard(currentUser);
    }

    function toggleAuth(isRegister) {
      document.getElementById('login-form').style.display = isRegister ? 'none' : 'block';
      document.getElementById('register-form').style.display = isRegister ? 'block' : 'none';
    }

    // [회원가입 기능 백엔드 통신]
    async function handleRegister() {
      const name = document.getElementById('reg-name').value;
      const email = document.getElementById('reg-email').value;
      const password = document.getElementById('reg-password').value;

      if(!name || !email || !password) return alert("가입 정보를 모두 입력하세요!");

      const res = await fetch('/api/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, password })
      });
      const data = await res.json();
      alert(data.message);
      if(res.status === 201) toggleAuth(false); // 가입 성공 시 로그인 창으로 전환
    }

    // [로그인 기능 백엔드 통신]
    async function handleLogin() {
      const email = document.getElementById('login-email').value;
      const password = document.getElementById('login-password').value;

      const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password })
      });
      const data = await res.json();
      if(res.status === 200) {
        sessionStorage.setItem('userName', data.userName); // 내 브라우저 열쇠고리에 이름 저장
        showDashboard(data.userName);
      } else {
        alert(data.message);
      }
    }

    function showDashboard(name) {
      currentUser = name;
      document.getElementById('auth-section').style.display = 'none';
      document.getElementById('main-section').style.display = 'block';
      document.getElementById('user-welcome').innerText = name;
    }

    function handleLogout() {
      sessionStorage.clear();
      window.location.reload();
    }

    // 공동구매 액션 함수들 (내 진짜 이름 명패를 전송함)
    async function createGroup() {
      const title = document.getElementById('title').value;
      const item = document.getElementById('item').value;
      const targetPeople = document.getElementById('targetPeople').value;

      if (!title || !item) return alert('내용을 입력해주세요!');

      const res = await fetch('/api/groups', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, item, targetPeople, writer: currentUser })
      });
      if (res.status === 201) window.location.reload();
    }

    async function joinGroup(id) {
      const res = await fetch(`/api/groups/${id}/join`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userName: currentUser })
      });
      if (res.status !== 200) {
        const data = await res.json();
        alert(data.message);
      } else {
        window.location.reload();
      }
    }

    async function leaveGroup(id) {
      const res = await fetch(`/api/groups/${id}/leave`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userName: currentUser })
      });
      if (res.status === 200) {
        alert('공구 참여를 취소했습니다.');
        window.location.reload();
      } else {
        const data = await res.json();
        alert(data.message);
      }
    }

    // 소켓 실시간 동기화 바인딩
    socket.on('status_updated', function(data) {
      window.location.reload(); // 실시간 참여인원 명단 갱신을 위해 상쾌하게 동기화 리로드
    });

    socket.on('room_deleted', function(data) {
      const roomCard = document.getElementById(`room-${data.id}`);
      if (roomCard) roomCard.remove();
    });
  </script>
</body>
</html>