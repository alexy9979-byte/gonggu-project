<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>🛒 실시간 우리동네 공구메이트</title>
  <!-- 세련된 UI를 위한 부트스트랩 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background-color: #f8f9fa; font-family: 'Pretendard', sans-serif; }
    .card { border-radius: 12px; border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
    .kakao-btn {
      background-color: #FEE500; color: #191919; border: none; padding: 14px;
      font-size: 16px; font-weight: bold; border-radius: 8px; width: 100%;
      display: flex; align-items: center; justify-content: center; gap: 10px;
      transition: all 0.2s;
    }
    .kakao-btn:hover { background-color: #FADA0A; opacity: 0.9; }
    .badge-recruiting { background-color: #0d6efd; }
    .badge-matched { background-color: #198754; }
  </style>
</head>
<body>

  <div class="container py-5">
    <!-- 헤더 영역 -->
    <div class="text-center mb-5">
      <h1 class="display-5 fw-bold text-primary">🛒 공구메이트</h1>
      <p class="text-muted">우리 동네 이웃들과 함께하는 실시간 공동구매 플랫폼</p>
    </div>

    <!-- 1. 로그인/회원가입 섹션 (로그인 전 표시) -->
    <div id="auth-section" class="card p-4 mx-auto mb-5" style="max-width: 450px;">
      <h4 class="text-center fw-bold mb-3">💬 서비스 시작하기</h4>
      <p class="text-center text-muted small mb-4">카카오톡 계정으로 1초 만에 간편하게 동네 실시간 공구에 참여해보세요!</p>
      
      <button onclick="handleKakaoLogin()" class="kakao-btn">
        <span>💛</span> 카카오 계정으로 로그인 / 가입
      </button>
    </div>

    <!-- 2. 메인 대시보드 섹션 (로그인 후 표시 - 기본값은 숨김 처리) -->
    <div id="main-dashboard" style="display: none;">
      <!-- 상단 유저 환영 바 -->
      <div class="alert alert-light card p-3 d-flex flex-row justify-content-between align-items-center mb-4">
        <div>
          <span class="fw-bold text-dark" id="user-display-name">홍길동</span>님, 반갑습니다! 
          <span class="badge bg-warning text-dark ms-2">💬 카카오 연동중</span>
        </div>
        <button onclick="handleLogout()" class="btn btn-outline-danger btn-sm">로그아웃</button>
      </div>

      <div class="row">
        <!-- 왼쪽: 공구방 개설하기 폼 -->
        <div class="col-md-4 mb-4">
          <div class="card p-4 h-100">
            <h4 class="fw-bold text-dark mb-4">📦 새로운 공구 열기</h4>
            <div class="mb-3">
              <label class="form-label small fw-bold">공구방 제목</label>
              <input type="text" id="group-title" class="form-control" placeholder="예: 한림아파트 앞 과일 노나드실 분">
            </div>
            <div class="mb-3">
              <label class="form-label small fw-bold">구매할 물품</label>
              <input type="text" id="group-item" class="form-control" placeholder="예: 샤인머스캣 3송이 박스">
            </div>
            <div class="mb-4">
              <label class="form-label small fw-bold">목표 모집 인원 (명)</label>
              <input type="number" id="group-target" class="form-control" value="2" min="2">
            </div>
            <button onclick="createGroup()" class="btn btn-primary w-100 fw-bold py-2">🚀 공동구매 방 개설</button>
          </div>
        </div>

        <!-- 오른쪽: 실시간 공구 목록 리스트 -->
        <div class="col-md-8 mb-4">
          <div class="card p-4 h-100">
            <h4 class="fw-bold text-dark mb-4">⚡ 우리 동네 실시간 공구 목록</h4>
            <div id="group-list" class="row row-cols-1 g-3">
              <!-- 서버에서 받아온 공구방 데이터가 ejs 렌더링 또는 소켓을 통해 그려집니다 -->
              <% if (groups && groups.length > 0) { %>
                <% groups.forEach(function(group) { %>
                  <div class="col" id="card-<%= group._id %>">
                    <div class="card p-3 border-start border-4 <%= group.status === '모집중' ? 'border-primary' : 'border-success' %>">
                      <div class="d-flex justify-content-between align-items-start">
                        <div>
                          <span class="badge <%= group.status === '모집중' ? 'badge-recruiting' : 'badge-matched' %> mb-2" id="status-badge-<%= group._id %>">
                            <%= group.status %>
                          </span>
                          <h5 class="fw-bold mb-1"><%= group.title %></h5>
                          <p class="text-muted small mb-2">📦 물품: <%= group.item %></p>
                          <div class="small">
                            👥 참여자 (<span id="count-<%= group._id %>"><%= group.participants.length %></span>/<%= group.targetPeople %>명): 
                            <span class="text-dark fw-bold" id="people-<%= group._id %>"><%= group.participants.join(', ') %></span>
                          </div>
                        </div>
                        <div class="d-flex flex-column gap-2" id="btn-area-<%= group._id %>">
                          <% if (group.status === '모집중') { %>
                            <button onclick="joinGroup('<%= group._id %>')" class="btn btn-sm btn-outline-primary px-3">참여하기</button>
                            <button onclick="leaveGroup('<%= group._id %>')" class="btn btn-sm btn-outline-danger px-3">취소</button>
                          <% } else { %>
                            <button class="btn btn-sm btn-secondary" disabled>매칭완료</button>
                          <% } %>
                        </div>
                      </div>
                    </div>
                  </div>
                <% }); %>
              <% } else { %>
                <div class="text-center py-5 text-muted" id="empty-message">
                  현재 개설된 공구방이 없습니다. 첫 번째 방을 열어보세요!
                </div>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 🛜 실시간 양방향 통신을 위한 Socket.io 및 라이브 로직 -->
  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
    let currentUser = localStorage.getItem('공구메이트_유저') || null;

    // 브라우저가 켜졌을 때 로그인 세션 유무 체크 및 UI 스위칭
    window.onload = function() {
      if (currentUser) {
        document.getElementById('auth-section').style.display = 'none';
        document.getElementById('main-dashboard').style.display = 'block';
        document.getElementById('user-display-name').innerText = currentUser;
      } else {
        document.getElementById('auth-section').style.display = 'block';
        document.getElementById('main-dashboard').style.display = 'none';
      }
    };

    // 💛 1. 카카오 간편 통합 로그인/가입 처리 함수
    async function handleKakaoLogin() {
      const userName = prompt("👥 시연용 카카오 계정 이름을 입력해주세요 (예: 홍길동):");
      if (!userName || userName.trim() === "") return alert("이름을 입력해야 로그인이 가능합니다.");

      const mockKakaoId = "kakao_" + Math.floor(Math.random() * 900000 + 100000);
      const mockEmail = `${mockKakaoId}@kakao.com`;

      const res = await fetch('/api/auth/kakao-login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ kakaoId: mockKakaoId, name: userName.trim(), email: mockEmail })
      });
      
      const data = await res.json();
      
      if (res.status === 200) {
        // 🔔 웰컴 알림톡 안내 시뮬레이션 얼럿 팝업
        alert(`${data.message}\n\n${data.talkNotification}`);
        
        localStorage.setItem('공구메이트_유저', data.userName);
        currentUser = data.userName;
        
        location.reload(); // 상태 적용 후 리로드
      } else {
        alert("카카오 연동 오류: " + data.message);
      }
    }

    // 로그아웃 처리
    function handleLogout() {
      localStorage.removeItem('공구메이트_유저');
      location.reload();
    }

    // 📦 2. 새로운 공동구매 방 개설 요청
    async function createGroup() {
      const title = document.getElementById('group-title').value;
      const item = document.getElementById('group-item').value;
      const targetPeople = document.getElementById('group-target').value;

      if (!title || !item) return alert("공구방 정보(제목/물품)를 입력해주세요!");

      const res = await fetch('/api/groups', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, item, targetPeople, writer: currentUser })
      });

      if (res.status === 201) {
        alert("🚀 성공적으로 공동구매 방이 개설되었습니다!");
        location.reload(); // 리스트 즉시 갱신
      }
    }

    // 🤝 3. 개설된 공구방 참여 신청 기능
    async function joinGroup(id) {
      const res = await fetch(`/api/groups/${id}/join`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userName: currentUser })
      });

      const data = await res.json();
      if (res.status === 200) {
        alert("✅ 공구방 참여 성공!");
        // 만약 매칭완료 알림톡 스펙이 내려오면 함께 팝업 처리
        if (data.matchNotification) {
          alert(data.matchNotification);
        }
      } else {
        alert(data.message);
      }
    }

    // 🚫 4. 공구방 매칭 취소 및 나가기 기능
    async function leaveGroup(id) {
      const res = await fetch(`/api/groups/${id}/leave`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userName: currentUser })
      });

      if (res.status === 200) {
        alert("🚪 공구방 참여를 취소했습니다.");
      } else {
        alert(data.message);
      }
    }

    // ==========================================
    // 🛜 Socket.io 실시간 웹소켓 화면 동기화 이벤트 무대
    // ==========================================
    
    // 누군가 참여/취소하여 공구방 상태가 실시간 업데이트 되었을 때
    socket.on('status_updated', (data) => {
      const g = data.group;
      
      // 인원수 및 명단 갱신
      const countEl = document.getElementById(`count-${g._id}`);
      const peopleEl = document.getElementById(`people-${g._id}`);
      if (countEl) countEl.innerText = g.participants.length;
      if (peopleEl) peopleEl.innerText = g.participants.join(', ');

      // 매칭 성사로 마감 스위칭 되었을 때 실시간 마감 처리
      if (g.status === '매칭완료') {
        const badge = document.getElementById(`status-badge-${g._id}`);
        if (badge) {
          badge.className = "badge badge-matched mb-2";
          badge.innerText = "매칭완료";
        }
        const btnArea = document.getElementById(`btn-area-${g._id}`);
        if (btnArea) {
          btnArea.innerHTML = `<button class="btn btn-sm btn-secondary" disabled>매칭완료</button>`;
        }
      }
    });

    // 5분 타이머가 끝나서 서버가 방을 폭파했거나 인원이 0명이 되어 방이 삭제되었을 때
    socket.on('room_deleted', (data) => {
      const targetCard = document.getElementById(`card-${data.id}`);
      if (targetCard) {
        targetCard.remove(); // 화면에서 즉시 흔적 삭제
      }
    });
  </script>
</body>
</html>