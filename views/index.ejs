<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>🛒 공구메이트 - 실시간 공동구매</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <script src="/socket.io/socket.io.js"></script>
</head>
<body class="bg-light">

  <div id="auth-section" class="container py-5 mt-5" style="max-width: 450px;">
    <div class="card p-4 shadow border-0 rounded-4">
      <h2 class="text-center fw-bold text-primary mb-4">🛒 공구메이트</h2>
      
      <div id="login-form">
        <h4 class="mb-3 fw-semibold">로그인</h4>
        <input type="email" id="login-email" class="form-control mb-2" placeholder="이메일 주소">
        <input type="password" id="login-password" class="form-control mb-3" placeholder="비밀번호">
        <button onclick="handleLogin()" class="btn btn-primary w-100 mb-3 fw-bold">로그인하기</button>
        <p class="text-center text-muted small">계정이 없으신가요? <a href="#" onclick="toggleAuth(true)">회원가입</a></p>
      </div>

      <div id="register-form" style="display: none;">
        <h4 class="mb-3 fw-semibold">회원가입</h4>
        <input type="text" id="reg-name" class="form-control mb-2" placeholder="이름 (닉네임)">
        
        <div class="input-group mb-2">
          <input type="email" id="reg-email" class="form-control" placeholder="사용할 이메일 주소">
          <button onclick="sendAuthCode()" class="btn btn-outline-primary btn-sm" type="button">인증 요청</button>
        </div>

        <div class="input-group mb-3" id="verification-area" style="display: none;">
          <input type="text" id="reg-code" class="form-control" placeholder="메일로 온 인증번호 6자리">
          <button onclick="verifyAuthCode()" class="btn btn-primary btn-sm" type="button">인증 확인</button>
        </div>
        
        <input type="hidden" id="is-email-verified" value="false">

        <input type="password" id="reg-password" class="form-control mb-3" placeholder="비밀번호 설정" disabled>
        <button onclick="handleRegister()" id="btn-submit-reg" class="btn btn-success w-100 mb-3 fw-bold" disabled>가입 완료하기</button>
        <p class="text-center text-muted small">이미 계정이 있으신가요? <a href="#" onclick="toggleAuth(false)">로그인</a></p>
      </div>
    </div>
  </div>

  <div id="main-section" class="container py-5" style="display: none;">
    <header class="pb-3 mb-4 border-bottom d-flex justify-content-between align-items-center">
      <div>
        <h1 class="display-5 fw-bold text-primary">🛒 공구메이트</h1>
        <p class="text-muted"><span id="user-welcome" class="fw-bold text-dark"></span>님 환영합니다!</p>
      </div>
      <button onclick="handleLogout()" class="btn btn-sm btn-outline-secondary">로그아웃</button>
    </header>

    <div class="row align-items-md-stretch">
      <div class="col-md-4">
        <div class="h-100 p-4 bg-white border rounded-3 shadow-sm">
          <h3 class="mb-3">🚀 새로운 공구방 열기</h3>
          <div class="mb-3">
            <label class="form-label">공구방 제목</label>
            <input type="text" id="title" class="form-control" placeholder="예: 정문 앞 치킨 공구">
          </div>
          <div class="mb-3">
            <label class="form-label">모집 물품</label>
            <input type="text" id="item" class="form-control" placeholder="예: 후라이드 치킨">
          </div>
          <div class="mb-3">
            <label class="form-label">목표 인원 (명)</label>
            <input type="number" id="targetPeople" class="form-control" value="2" min="2">
          </div>
          <button onclick="createGroup()" class="btn btn-primary w-100">방 만들기</button>
        </div>
      </div>

      <div class="col-md-8">
        <div class="h-100 p-4 bg-white border rounded-3 shadow-sm">
          <h3 class="mb-3">📢 현재 모집 중인 공구방</h3>
          <div id="group-list" class="list-group">
            <% if (groups.length === 0) { %>
              <p id="no-rooms-msg" class="text-muted p-3 text-center">현재 개설된 공구방이 없습니다. 첫 번째 방을 만들어보세요!</p>
            <% } %>
            <% groups.forEach(function(group) { %>
              <div class="list-group-item p-3 mb-2 border rounded shadow-sm" id="room-<%= group._id %>">
                <div class="d-flex w-100 justify-content-between align-items-center">
                  <h5 class="mb-1 fw-bold text-dark"><%= group.title %></h5>
                  <span class="badge <%= group.status === '매칭완료' ? 'bg-danger' : 'bg-success' %> rounded-pill p-2" id="status-<%= group._id %>"><%= group.status %></span>
                </div>
                <p class="mb-2 text-secondary">🎁 품목: <strong><%= group.item %></strong></p>
                <div class="d-flex justify-content-between align-items-center">
                  <span class="text-primary fw-bold">
                    참여자: <span class="text-dark small" id="list-<%= group._id %>"><%= group.participants.join(', ') %></span> 
                    (<span id="count-<%= group._id %>"><%= group.participants.length %></span> / <%= group.targetPeople %> 명)
                  </span>
                  <div>
                    <button onclick="leaveGroup('<%= group._id %>')" class="btn btn-sm btn-outline-danger me-1" id="btn-leave-<%= group._id %>" <%= group.status === '매칭완료' ? 'disabled' : '' %>>취소하기</button>
                    <button onclick="joinGroup('<%= group._id %>')" class="btn btn-sm btn-outline-primary" id="btn-<%= group._id %>" <%= group.status === '매칭완료' ? 'disabled' : '' %>>참여하기</button>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const socket = io();
    let currentUser = sessionStorage.getItem('userName');

    if (currentUser) showDashboard(currentUser);

    // 로그인 - 회원가입 화면 스위칭 기능
    function toggleAuth(isRegister) {
      document.getElementById('login-form').style.display = isRegister ? 'none' : 'block';
      document.getElementById('register-form').style.display = isRegister ? 'block' : 'none';
    }

    // 📧 1. 진짜 이메일 주소로 인증번호 발송 요청 함수
    async function sendAuthCode() {
      const email = document.getElementById('reg-email').value;
      if(!email) return alert("이메일을 입력해주세요!");

      const res = await fetch('/api/auth/send-code', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email })
      });
      const data = await res.json();
      
      alert(data.message); // 전송 결과 안내 (성공 혹은 실패 사유 알림)
      if(res.status === 200) {
        document.getElementById('verification-area').style.display = 'flex'; // 인증번호 입력칸 표시
      }
    }

    // 📧 2. 유저가 입력한 메일 인증번호 매칭 검증 함수
    async function verifyAuthCode() {
      const email = document.getElementById('reg-email').value;
      const code = document.getElementById('reg-code').value;
      if(!code) return alert("인증번호를 입력해주세요!");

      const res = await fetch('/api/auth/verify-code', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, code })
      });
      const data = await res.json();
      alert(data.message);

      if(res.status === 200) {
        // 인증 통과 시 잠금장치 완전 해제 조치
        document.getElementById('is-email-verified').value = "true";
        document.getElementById('reg-email').disabled = true;
        document.getElementById('reg-code').disabled = true;
        document.getElementById('reg-password').disabled = false;  // 비번 창 열기
        document.getElementById('btn-submit-reg').disabled = false; // 가입 버튼 활성화
      }
    }

    // 📝 3. 회원가입 최종 제출 통신 (가입 성공 시 로그인 첫 페이지로 자동 이동)
    async function handleRegister() {
      const name = document.getElementById('reg-name').value;
      const email = document.getElementById('reg-email').value;
      const password = document.getElementById('reg-password').value;
      const isVerified = document.getElementById('is-email-verified').value;

      if(isVerified !== "true") return alert("이메일 인증을 먼저 완료해주세요!");
      if(!name || !password) return alert("가입 비밀번호와 이름을 모두 입력하세요!");

      const res = await fetch('/api/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, password })
      });
      
      if(res.status === 201) {
        alert("🎉 회원가입 성공! 로그인 화면으로 자동으로 깔끔하게 이동합니다.");
        toggleAuth(false); // 👈 가입 즉시 첫 화면(로그인 창)으로 폼 체인지 자동화 구현
      } else {
        const data = await res.json();
        alert(data.message);
      }
    }

    // 🔐 4. 백엔드 로그인 연동 처리
    async function handleLogin() {
      const email = document.getElementById('login-email').value;
      const password = document.getElementById('login-password').value;
      const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password })
      });
      const data = await res.json();
      if(res.status === 200) {
        sessionStorage.setItem('userName', data.userName);
        showDashboard(data.userName);
      } else { alert(data.message); }
    }

    function showDashboard(name) {
      currentUser = name;
      document.getElementById('auth-section').style.display = 'none';
      document.getElementById('main-section').style.display = 'block';
      document.getElementById('user-welcome').innerText = name;
    }

    function handleLogout() { sessionStorage.clear(); window.location.reload(); }

    // 🛒 5. 공동구매 서비스 액션 모듈 연동
    async function createGroup() {
      const title = document.getElementById('title').value;
      const item = document.getElementById('item').value;
      const targetPeople = document.getElementById('targetPeople').value;
      if (!title || !item) return alert('내용을 입력해주세요!');

      await fetch('/api/groups', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, item, targetPeople, writer: currentUser })
      });
      window.location.reload();
    }

    async function joinGroup(id) {
      const res = await fetch(`/api/groups/${id}/join`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userName: currentUser })
      });
      const data = await res.json();
      if (res.status !== 200) {
        alert(data.message);
      } else {
        window.location.reload();
      }
    }

    async function leaveGroup(id) {
      const res = await fetch(`/api/groups/${id}/leave`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userName: currentUser })
      });
      if (res.status === 200) {
        alert('공구 참여를 취소했습니다.');
        window.location.reload();
      } else {
        const data = await res.json();
        alert(data.message);
      }
    }

    // 📡 Socket.io 양방향 실시간 리스너 동기화
    socket.on('status_updated', function(data) {
      const group = data.group;
      if(group.status === '매칭완료') {
        alert(`🎉 [${group.title}] 공구 매칭 성공! 5분 뒤 리스트에서 안전하게 폭파 제거됩니다.`);
      }
      window.location.reload();
    });

    socket.on('room_deleted', function(data) {
      const roomCard = document.getElementById(`room-${data.id}`);
      if (roomCard) roomCard.remove();
    });
  </script>
</body>
</html>